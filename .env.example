# HealthGuard AI - Environment Variables
# Copy this file to .env and configure your local values.

# Backend secret key (generate a secure random key)
SECRET_KEY=replace_with_a_secure_random_secret_key

# Database URL (default: SQLite for development)
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/healthguard_db
DATABASE_URL=sqlite:///./healthguard.db

# API base URL (used by Streamlit frontend)
API_BASE_URL=http://127.0.0.1:8000/api

# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440